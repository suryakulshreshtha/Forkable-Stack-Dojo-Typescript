# 05-quality/sonarqube — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md

# Your local SonarQube server.
SONAR_HOST_URL=http://localhost:9000

# SECRET. Uploads analysis results as you — treat it like a password.
# Generate it in SonarQube: My Account → Security → Generate Token.
SONAR_TOKEN=REPLACE_ME

# Which project the results belong to.
SONAR_PROJECT_KEY=stack-dojo
