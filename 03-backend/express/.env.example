# 03-backend/express — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md

# Which port the API listens on. Keep 3000 free for the frontend.
PORT=3001

# development | test | production. Changes error verbosity.
NODE_ENV=development

# Which browser origin may call this API. Never "*" once you use cookies.
CORS_ORIGIN=http://localhost:3000
