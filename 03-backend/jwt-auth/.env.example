# 03-backend/jwt-auth — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md
#
# Generate each secret separately (same command on macOS and Windows):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# SECRET. Signs access tokens. Anyone with this can mint a token as any user.
JWT_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES

# Access-token lifetime. Short on purpose.
JWT_EXPIRES_IN=15m

# SECRET. Signs refresh tokens. MUST be a different value from JWT_SECRET.
JWT_REFRESH_SECRET=REPLACE_ME_WITH_DIFFERENT_32_RANDOM_BYTES

# Refresh-token lifetime.
JWT_REFRESH_EXPIRES_IN=7d
