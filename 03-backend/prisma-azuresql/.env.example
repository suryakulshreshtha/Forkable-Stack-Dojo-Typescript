# 03-backend/prisma-azuresql — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md

# SECRET. The one string Prisma connects with — it contains a password.
# Local Docker SQL Server:
DATABASE_URL="sqlserver://localhost:1433;database=dojo;user=sa;password=REPLACE_ME;encrypt=true;trustServerCertificate=true"
# Azure SQL: remove trustServerCertificate, keep encrypt=true, use a least-privilege user.

# SECRET. Password for the local SQL Server container.
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol)
# or the container exits immediately with no obvious reason.
MSSQL_SA_PASSWORD=REPLACE_ME

# Used by the raw `mssql` driver exercise (not by Prisma)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=dojo
DB_USER=sa
# SECRET. Same value as MSSQL_SA_PASSWORD when running locally.
DB_PASSWORD=REPLACE_ME
