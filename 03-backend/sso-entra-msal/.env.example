# 03-backend/sso-entra-msal — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md
# All values come from your Entra ID app registration (portal.azure.com).

# Which Entra ID directory to sign users into. Public value.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Your app registration's ID. Public by design.
AZURE_CLIENT_ID=11111111-1111-1111-1111-111111111111

# SECRET. Proves your server IS that app. Shown once in the portal — and it EXPIRES.
# Write the expiry date somewhere you will see it before sign-in breaks.
AZURE_CLIENT_SECRET=REPLACE_ME

# Must match the app registration EXACTLY, including any trailing slash.
AZURE_REDIRECT_URI=http://localhost:3001/auth/callback

# The identity endpoint. Differs in sovereign clouds.
AZURE_CLOUD_INSTANCE=https://login.microsoftonline.com/

# SECRET. Signs the session cookie holding sign-in state.
SESSION_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES
