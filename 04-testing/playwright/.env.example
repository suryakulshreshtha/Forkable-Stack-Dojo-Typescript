# 04-testing/playwright — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md

# What page.goto('/') resolves against.
BASE_URL=http://localhost:3000

# A seeded test account. NEVER a real person's credentials.
TEST_USER_EMAIL=test@example.com
# SECRET (test-only, but still a secret — test accounts get abused).
TEST_USER_PASSWORD=REPLACE_ME

# CI is set automatically by CI providers; leave it unset locally.
# CI=true
