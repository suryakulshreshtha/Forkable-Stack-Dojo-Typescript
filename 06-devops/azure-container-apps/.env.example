# Azure deployment values — copy to .env and edit:  cp .env.example .env
# Full explanation of every variable: ../../docs/03-env-files-and-secrets.md
#
# 💰 These create REAL, BILLABLE resources. Every dojo ends with a teardown
#    command. Run it.

# Which subscription gets billed.
AZURE_SUBSCRIPTION_ID=22222222-2222-2222-2222-222222222222

# The folder your resources live in. Deleting it deletes them all — your teardown handle.
AZURE_RESOURCE_GROUP=rg-stack-dojo

# Which region. Affects price and latency.
AZURE_LOCATION=centralindia

# Container registry name: globally unique, lowercase letters and numbers only.
ACR_NAME=acrstackdojo

# SECRET. Pushes images as you. Prefer a managed identity in real projects.
ACR_PASSWORD=REPLACE_ME

# The Container App to deploy to.
CONTAINER_APP_NAME=ca-stack-dojo

# Which image version runs. Avoid "latest" — it makes rollbacks guesswork.
IMAGE_TAG=v1

# SECRET. Passed to the app as a platform secret reference, not a plain env var.
JWT_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES
